syntax = "proto3";

option go_package = "github.com/rogeriocassares/zc8/packages/proto/telemetry/v1";

package zc8_telemetry_proto_v1;

// The greeting service definition.
service Greeter {
  // service TelemetryService {

  // Sends a greeting
  rpc SendMessageToServer(HelloRequest) returns (HelloReply) {}
}

// The request message containing the user's name.
message HelloRequest {
  string Zc8Instance = 1;
  string Organization = 2;
  string DeviceType = 3;
  string DeviceModel = 4;
  string Measurement = 5;
  string DeviceId = 6;
  string Direction = 7;
  string Etc = 8;
  string Payload = 9;
}

// The response message containing the greetings
message HelloReply { string message = 1; }