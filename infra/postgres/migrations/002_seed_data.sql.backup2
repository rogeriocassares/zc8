-- ============================================================================
-- PostgreSQL Consolidated Migration 002: SEED COMPLETE DATA (DML Only)
-- ============================================================================
-- Version: 2.0 - Consolidated seed data for complete refactored schema
-- Consolidates: 002 Core Data + 004 Routing Config + 008 Vendor Models & Providers
-- Status: Fresh seed data for all organizations, vendors, models, providers
-- ============================================================================

BEGIN;

-- ============================================================================
-- SECTION 1: SEED DEVICE TYPES
-- ============================================================================

INSERT INTO device_types (id, name, protocol) VALUES
    (1001, 'LoRaWAN', 'lora'),
    (3001, 'MQTT', 'mqtt'),
    (5001, 'gRPC', 'grpc')
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 2: SEED DEVICE VENDORS (Manufacturers Only)
-- ============================================================================

INSERT INTO device_vendors (name, code, description) VALUES
    ('Milesight', 'milesight', 'Milesight IoT sensor and gateway solutions'),
    ('Kron', 'kron', 'Kron energy monitoring and control devices'),
    ('Khomp', 'khomp', 'Khomp industrial gateway and meter solutions'),
    ('Zc2x', 'zc2x', 'Zc2x ESP32-based IoT embedded systems'),
    ('Agent', 'agent', 'Agent distributed telemetry agent service'),
    ('Schneider', 'schneider', 'Schneider Electric industrial automation and control')
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 3: SEED DEVICE PROVIDERS (External Integrations)
-- ============================================================================

INSERT INTO device_providers (name, code, provider_type, description, api_endpoint_template, requires_authentication) VALUES
    ('ChirpStack', 'chirpstack', 'lns', 'ChirpStack LoRaWAN Network Server', 'https://{host}:{port}/api', true),
    ('Everynet', 'everynet', 'lns', 'Everynet LPWAN Management Platform', 'https://api.{region}.everynet.com', true),
    ('Schneider Cloud', 'schneider-cloud', 'cloud', 'Schneider Electric cloud platform', 'https://api.schneider-electric.cloud', true),
    ('Engil', 'engil', 'integration', 'Engil data integration platform', 'https://platform.engil.io/api', true)
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 4: SEED ORGANIZATIONS
-- ============================================================================

INSERT INTO organizations (name, slug, description, is_public) VALUES
    ('Admin', 'admin', 'Super organization with access to all organizations', FALSE),
    ('IMT', 'imt', 'Instituto Mauá de Tecnologia - Racing Organization', FALSE),
    ('FSAELive', 'fsaelive', 'Formula SAE Live - Event and Track Management', FALSE)
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 5: SEED TEAMS
-- ============================================================================

INSERT INTO teams (organization_id, name, slug, description, team_type, is_public)
SELECT org.id, 'SuperAdmin', 'superadmin', 'Team with access to all teams', 'special', FALSE
FROM organizations org WHERE org.slug = 'admin'
ON CONFLICT DO NOTHING;

INSERT INTO teams (organization_id, name, slug, description, team_type, is_public)
SELECT org.id, 'MauaRacing', 'maua-racing', 'Mauá Racing Team', 'project', FALSE
FROM organizations org WHERE org.slug = 'imt'
ON CONFLICT DO NOTHING;

INSERT INTO teams (organization_id, name, slug, description, team_type, is_public)
SELECT org.id, 'GMS', 'gms', 'General Maintenance & Support', 'department', FALSE
FROM organizations org WHERE org.slug = 'imt'
ON CONFLICT DO NOTHING;

