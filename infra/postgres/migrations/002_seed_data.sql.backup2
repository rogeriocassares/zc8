-- ============================================================================
-- SECTION 7: PROVIDER TRANSPORT BINDINGS (Static Integration Mappings)
-- ============================================================================

-- ChirpStack → MQTT-Subscriber
INSERT INTO provider_transport_bindings (device_provider_id, transport_type, description, default_topic_pattern)
SELECT id, 'mqtt-subscriber', 'ChirpStack publishes uplinks via MQTT', 'chirpstack/+/device/+/rx'
FROM device_providers WHERE code = 'chirpstack'
ON CONFLICT DO NOTHING;

-- Everynet → HTTP-Server
INSERT INTO provider_transport_bindings (device_provider_id, transport_type, description, default_http_path)
SELECT id, 'http-server', 'Everynet sends uplinks as HTTP webhooks', '/api/v0/webhooks/uplink'
FROM device_providers WHERE code = 'everynet'
ON CONFLICT DO NOTHING;

-- Schneider Cloud → HTTP-Client
INSERT INTO provider_transport_bindings (device_provider_id, transport_type, description, default_http_path)
SELECT id, 'http-client', 'Schneider Cloud pulls telemetry via HTTP', '/api/v2/pull/devices'
FROM device_providers WHERE code = 'schneider-cloud'
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 8: DEVICE MODELS - DIRECT gRPC DEVICES
-- ============================================================================

-- Zc2x i2n
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type, direct_transport_type,
    has_device_key, description
)
SELECT dv.id, 'i2n', 'zc2x-i2n', dt.id,
    '4g', 'direct', 'grpc-server', true, 'Zc2x i2n telemetry unit with 4G connectivity'
FROM device_vendors dv
JOIN device_types dt ON dt.name = 'gRPC'
WHERE dv.code = 'zc2x'
ON CONFLICT DO NOTHING;

-- Zc2x v2n
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type, direct_transport_type,
    has_device_key, description
)
SELECT dv.id, 'v2n', 'zc2x-v2n', dt.id,
    'ethernet', 'direct', 'grpc-server', true, 'Zc2x v2n high-speed telemetry unit with Ethernet'
FROM device_vendors dv
JOIN device_types dt ON dt.name = 'gRPC'
WHERE dv.code = 'zc2x'
ON CONFLICT DO NOTHING;

-- Agent edge-agent
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type, direct_transport_type,
    has_device_key, description
)
SELECT dv.id, 'edge-agent', 'agent-v1', dt.id,
    'ethernet', 'direct', 'grpc-server', true, 'Agent distributed telemetry collection service'
FROM device_vendors dv
JOIN device_types dt ON dt.name = 'gRPC'
WHERE dv.code = 'agent'
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 9: DEVICE MODELS - DIRECT MQTT DEVICES
-- ============================================================================

-- Kron ks3000-wifi
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type, direct_transport_type,
    has_mac_address, description
)
SELECT dv.id, 'ks3000-wifi', 'kron-ks3000-wifi', dt.id,
    'wifi', 'direct', 'mqtt-subscriber', true, 'Kron ks3000 energy monitor with WiFi connectivity'
FROM device_vendors dv
JOIN device_types dt ON dt.name = 'MQTT'
WHERE dv.code = 'kron'
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 10: DEVICE MODELS - LNS-ROUTED LOR AWAN DEVICES
-- ============================================================================

-- Kron ks3000-lora (ChirpStack + Everynet)
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type,
    supported_lns_vendors, can_use_multiple_lns, has_eui, description
)
SELECT dv.id, 'ks3000-lora', 'kron-ks3000-lora', dt.id,
    'lorawan', 'lns',
    ARRAY[dp_chirp.id, dp_every.id]::BIGINT[], true, true,
    'Kron ks3000 energy monitor with LoRaWAN - supports ChirpStack and Everynet'
FROM device_vendors dv
JOIN device_types dt ON dt.name = 'LoRaWAN'
LEFT JOIN device_providers dp_chirp ON dp_chirp.code = 'chirpstack'
LEFT JOIN device_providers dp_every ON dp_every.code = 'everynet'
WHERE dv.code = 'kron'
ON CONFLICT DO NOTHING;

-- Milesight EM500 (ChirpStack + Everynet)
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type,
    supported_lns_vendors, can_use_multiple_lns, has_eui, description
)
SELECT dv.id, 'em500-swl', 'milesight-em500', dt.id,
    'lorawan', 'lns',
    ARRAY[dp_chirp.id, dp_every.id]::BIGINT[], true, true,
    'Milesight EM500 multi-channel sensor via LoRaWAN'
FROM device_vendors dv
JOIN device_types dt ON dt.name = 'LoRaWAN'
LEFT JOIN device_providers dp_chirp ON dp_chirp.code = 'chirpstack'
LEFT JOIN device_providers dp_every ON dp_every.code = 'everynet'
WHERE dv.code = 'milesight'
ON CONFLICT DO NOTHING;

-- Khomp DTL200 (ChirpStack + Everynet)
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type,
    supported_lns_vendors, can_use_multiple_lns, has_eui, description
)
SELECT dv.id, 'dtl200', 'khomp-dtl200', dt.id,
    'lorawan', 'lns',
    ARRAY[dp_chirp.id, dp_every.id]::BIGINT[], true, true,
    'Khomp DTL200 industrial data logger via LoRaWAN'
FROM device_vendors dv
JOIN device_types dt ON dt.name = 'LoRaWAN'
LEFT JOIN device_providers dp_chirp ON dp_chirp.code = 'chirpstack'
LEFT JOIN device_providers dp_every ON dp_every.code = 'everynet'
WHERE dv.code = 'khomp'
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 11: DEVICE MODELS - CLOUD-ROUTED DEVICES
-- ============================================================================

-- Schneider sch-37 (Cloud-only)
INSERT INTO device_models (
    device_vendor_id, model_name, model_code, device_type_id,
    network_interface, connection_type,
    cloud_provider_id, description
)
SELECT dv.id, 'sch-37', 'schneider-sch37', 
    (SELECT id FROM device_types WHERE name = 'gRPC' LIMIT 1),
    'ethernet', 'cloud', dp.id,
    'Schneider Electric sch-37 power management unit - requires Schneider Cloud'
FROM device_vendors dv, device_providers dp
WHERE dv.code = 'schneider' AND dp.code = 'schneider-cloud'
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 12: DEVICE MODEL ROUTING RULES
-- ============================================================================

-- Zc2x i2n: direct gRPC
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, direct_transport_type)
SELECT dm.id, 'direct', 'grpc-server'
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
WHERE dv.code = 'zc2x' AND dm.model_code = 'zc2x-i2n'
ON CONFLICT DO NOTHING;

-- Zc2x v2n: direct gRPC
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, direct_transport_type)
SELECT dm.id, 'direct', 'grpc-server'
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
WHERE dv.code = 'zc2x' AND dm.model_code = 'zc2x-v2n'
ON CONFLICT DO NOTHING;

-- Agent: direct gRPC
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, direct_transport_type)
SELECT dm.id, 'direct', 'grpc-server'
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
WHERE dv.code = 'agent'
ON CONFLICT DO NOTHING;

-- Kron ks3000-wifi: direct MQTT
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, direct_transport_type)
SELECT dm.id, 'direct', 'mqtt-subscriber'
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
WHERE dv.code = 'kron' AND dm.model_code = 'kron-ks3000-wifi'
ON CONFLICT DO NOTHING;

-- Kron ks3000-lora: LNS routing
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, supported_lns_providers, can_use_multiple_lns)
SELECT dm.id, 'lns',
    ARRAY[dp_chirp.id, dp_every.id]::BIGINT[], true
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
LEFT JOIN device_providers dp_chirp ON dp_chirp.code = 'chirpstack'
LEFT JOIN device_providers dp_every ON dp_every.code = 'everynet'
WHERE dv.code = 'kron' AND dm.model_code = 'kron-ks3000-lora'
ON CONFLICT DO NOTHING;

-- Milesight EM500: LNS routing
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, supported_lns_providers, can_use_multiple_lns)
SELECT dm.id, 'lns',
    ARRAY[dp_chirp.id, dp_every.id]::BIGINT[], true
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
LEFT JOIN device_providers dp_chirp ON dp_chirp.code = 'chirpstack'
LEFT JOIN device_providers dp_every ON dp_every.code = 'everynet'
WHERE dv.code = 'milesight' AND dm.model_code = 'milesight-em500'
ON CONFLICT DO NOTHING;

-- Khomp DTL200: LNS routing
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, supported_lns_providers, can_use_multiple_lns)
SELECT dm.id, 'lns',
    ARRAY[dp_chirp.id, dp_every.id]::BIGINT[], true
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
LEFT JOIN device_providers dp_chirp ON dp_chirp.code = 'chirpstack'
LEFT JOIN device_providers dp_every ON dp_every.code = 'everynet'
WHERE dv.code = 'khomp' AND dm.model_code = 'khomp-dtl200'
ON CONFLICT DO NOTHING;

-- Schneider sch-37: Cloud routing
INSERT INTO device_model_routing_rules (device_model_id, routing_pattern, required_cloud_provider_id)
SELECT dm.id, 'cloud', dp.id
FROM device_models dm
JOIN device_vendors dv ON dm.device_vendor_id = dv.id
LEFT JOIN device_providers dp ON dp.code = 'schneider-cloud'
WHERE dv.code = 'schneider' AND dm.model_code = 'schneider-sch37'
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 13: TRANSPORT ENDPOINTS (IMT Org)
-- ============================================================================

-- gRPC Server for direct device ingress
INSERT INTO transport_endpoints (org_id, transport_type, connection_name, address, port, is_active)
SELECT o.id, 'grpc-server', 'Primary Device ingress gRPC Server',
    'device-ingress.imt-dev.svc.cluster.local', 50051, true
FROM organizations o WHERE o.slug = 'imt'
ON CONFLICT DO NOTHING;

-- MQTT Subscriber for ChirpStack integration
INSERT INTO transport_endpoints (org_id, transport_type, connection_name, address, port, mqtt_topic_pattern, is_active)
SELECT o.id, 'mqtt-subscriber', 'ChirpStack Integration MQTT Bridge',
    'mosquitto.imt-dev.svc.cluster.local', 1883, 'chirpstack/+/device/+/rx', true
FROM organizations o WHERE o.slug = 'imt'
ON CONFLICT DO NOTHING;

-- HTTP Server for Everynet webhooks
INSERT INTO transport_endpoints (org_id, transport_type, connection_name, address, port, http_path, is_active)
SELECT o.id, 'http-server', 'Everynet Webhook Receiver',
    'webhook-receiver.imt-dev.svc.cluster.local', 8080, '/api/v0/webhooks/events', true
FROM organizations o WHERE o.slug = 'imt'
ON CONFLICT DO NOTHING;

-- ============================================================================
-- SECTION 14: ORGANIZATION DEVICE PROVIDERS (IMT Org)
-- ============================================================================

-- ChirpStack (Primary)
INSERT INTO org_device_providers (
    org_id, device_provider_id, provider_instance_name, description,
    api_endpoint, api_key, transport_endpoint_id,
    region, is_active, is_primary
)
SELECT o.id, dp.id, 'ChirpStack Production', 'Primary LNS for LoRaWAN devices',
    'chirpstack.imt.prod.svc.cluster.local', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...',
    te.id, 'South America', true, true
FROM organizations o
JOIN device_providers dp ON dp.code = 'chirpstack'
JOIN transport_endpoints te ON te.org_id = o.id AND te.transport_type = 'mqtt-subscriber'
WHERE o.slug = 'imt'
ON CONFLICT DO NOTHING;

-- Everynet (Secondary/Failover)
INSERT INTO org_device_providers (
    org_id, device_provider_id, provider_instance_name, description,
    api_endpoint, api_key, transport_endpoint_id,
    region, is_active, is_primary
)
SELECT o.id, dp.id, 'Everynet EU', 'Secondary LNS for failover',
    'api.eu.everynet.com', 'ev_api_key_XXXXX',
    te.id, 'Europe', true, false
FROM organizations o
JOIN device_providers dp ON dp.code = 'everynet'
JOIN transport_endpoints te ON te.org_id = o.id AND te.transport_type = 'http-server'
WHERE o.slug = 'imt'
ON CONFLICT DO NOTHING;

COMMIT;

\echo 'Seed data inserted successfully!'
\echo '- 3 Organizations (Admin, IMT, FSAELive)'
\echo '- 6 Device Vendors'
\echo '- 4 Device Providers'
\echo '- 8 Device Models'
\echo '- 8 Device Model Routing Rules'
\echo '- 3 Transport Endpoints (IMT)'
\echo '- 2 Organization Device Providers (ChirpStack + Everynet for IMT)'
