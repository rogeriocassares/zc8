      "text": "syntax = \"proto3\";\n\noption go_package = \"github.com/rogeriocassares/zc8/packages/proto/telemetry/v1\";\n\npackage zc8_telemetry_proto_v1;\n\nimport \"google/protobuf/any.proto\";\nimport \"google/protobuf/timestamp.proto\";\n\nservice TelemetryService {\n  rpc IngestTelemetry(IngestTelemetryRequest) returns (IngestTelemetryResponse);\n  rpc StreamTelemetry(stream IngestTelemetryRequest)\n      returns (IngestTelemetryResponse);\n}\n\nservice CommandService {\n  rpc SendCommand(SendCommandRequest) returns (SendCommandResponse);\n  rpc AcknowledgeCommand(AcknowledgeCommandRequest)\n      returns (AcknowledgeCommandResponse);\n}\n\nmessage IngestTelemetryRequest {\n  string device_id = 1;\n  // google.protobuf.Any data = 2;\n  bytes data = 2;\n  google.protobuf.Timestamp timestamp = 3;\n}\n\nmessage IngestTelemetryResponse {\n  bool success = 1;\n  string message_id = 2;\n  string error = 3;\n}\n\nmessage SendCommandRequest {\n  string device_id = 1;\n  google.protobuf.Any command_data = 2;\n  google.protobuf.Timestamp timestamp = 3;\n}\n\nmessage SendCommandResponse {\n  bool success = 1;\n  string command_id = 2;\n  string error = 3;\n}\n\nmessage AcknowledgeCommandRequest {\n  string command_id = 1;\n  string device_id = 2;\n  google.protobuf.Timestamp received_at = 3;\n}\n\nmessage AcknowledgeCommandResponse {\n  bool success = 1;\n  string message = 2;\n}\n// Breakdown of the Example\n// The provided .proto file defines two gRPC services for sensor communication:\n// TelemetryService (data from sensors) and CommandService (data to sensors),\n// following protocol buffer best practices.//\n\n// TelemetryService\n// GetSensorData: Unary RPC to request sensor readings.\n// Request: GetSensorDataRequest (sensor ID and optional timestamp).\n// Response: GetSensorDataResponse (list of SensorReading and status).\n// StreamTelemetry: Server-streaming RPC for continuous telemetry.\n// Request: StreamTelemetryRequest (sensor ID).\n// Response: Stream of TelemetryData messages.\n// CommandService\n// SendCommand: Unary RPC to send a command to a sensor.\n// Request: SendCommandRequest (command type, parameters, target).\n// Response: SendCommandResponse (success flag, message, command ID).\n// AcknowledgeCommand: RPC to confirm command receipt.\n// Request: AcknowledgeCommandRequest (command ID).\n// Response: google.protobuf.Empty (no content).\n// Message Design\n// All messages use CamelCase.\n// Fields use lower_snake_case.\n// Reusable types like SensorReading and TelemetryData encapsulate structured\n// data. Using google.protobuf.Empty allows future expansion (e.g., adding\n// metadata)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "LoDsACPYzGE02GNYKXEwz",
      "originalText": "syntax = \"proto3\";\n\noption go_package = \"github.com/rogeriocassares/zc8/packages/proto/telemetry/v1\";\n\npackage zc8_telemetry_proto_v1;\n\nimport \"google/protobuf/any.proto\";\nimport \"google/protobuf/timestamp.proto\";\n\nservice TelemetryService {\n  rpc IngestTelemetry(IngestTelemetryRequest) returns (IngestTelemetryResponse);\n  rpc StreamTelemetry(stream IngestTelemetryRequest)\n      returns (IngestTelemetryResponse);\n}\n\nservice CommandService {\n  rpc SendCommand(SendCommandRequest) returns (SendCommandResponse);\n  rpc AcknowledgeCommand(AcknowledgeCommandRequest)\n      returns (AcknowledgeCommandResponse);\n}\n\nmessage IngestTelemetryRequest {\n  string device_id = 1;\n  // google.protobuf.Any data = 2;\n  bytes data = 2;\n  google.protobuf.Timestamp timestamp = 3;\n}\n\nmessage IngestTelemetryResponse {\n  bool success = 1;\n  string message_id = 2;\n  string error = 3;\n}\n\nmessage SendCommandRequest {\n  string device_id = 1;\n  google.protobuf.Any command_data = 2;\n  google.protobuf.Timestamp timestamp = 3;\n}\n\nmessage SendCommandResponse {\n  bool success = 1;\n  string command_id = 2;\n  string error = 3;\n}\n\nmessage AcknowledgeCommandRequest {\n  string command_id = 1;\n  string device_id = 2;\n  google.protobuf.Timestamp received_at = 3;\n}\n\nmessage AcknowledgeCommandResponse {\n  bool success = 1;\n  string message = 2;\n}\n// Breakdown of the Example\n// The provided .proto file defines two gRPC services for sensor communication:\n// TelemetryService (data from sensors) and CommandService (data to sensors),\n// following protocol buffer best practices.//\n\n// TelemetryService\n// GetSensorData: Unary RPC to request sensor readings.\n// Request: GetSensorDataRequest (sensor ID and optional timestamp).\n// Response: GetSensorDataResponse (list of SensorReading and status).\n// StreamTelemetry: Server-streaming RPC for continuous telemetry.\n// Request: StreamTelemetryRequest (sensor ID).\n// Response: Stream of TelemetryData messages.\n// CommandService\n// SendCommand: Unary RPC to send a command to a sensor.\n// Request: SendCommandRequest (command type, parameters, target).\n// Response: SendCommandResponse (success flag, message, command ID).\n// AcknowledgeCommand: RPC to confirm command receipt.\n// Request: AcknowledgeCommandRequest (command ID).\n// Response: google.protobuf.Empty (no content).\n// Message Design\n// All messages use CamelCase.\n// Fields use lower_snake_case.\n// Reusable types like SensorReading and TelemetryData encapsulate structured\n// data. Using google.protobuf.Empty allows future expansion (e.g., adding\n// metadata)",
